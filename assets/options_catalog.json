    {
      "id": "metadata",
      "label": "Metadata",
      "description": "Campos de metadatos para el EPUB resultante."
    },
    {
      "id": "debug",
      "label": "Debug",
      "description": "Herramientas de depuración y verbosidad."
    },
    {
      "id": "pdf_input",
      "label": "PDF Input",
      "description": "Controla la interpretación del PDF de entrada."
    },
    {
      "id": "epub_output",
      "label": "EPUB Output",
