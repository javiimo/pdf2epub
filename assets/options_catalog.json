    {
      "id": "profiles",
      "label": "Comunes / Perfiles",
      "description": "Opciones globales y perfiles prediseñados ofrecidos por calibre."
    },
    {
      "id": "look_and_feel",
      "label": "Look & Feel",
      "description": "Tipografías, espaciado y transformaciones CSS/HTML."
